{
  "info": {
    "name": "Policy Claims Tracker API",
    "description": "Postman collection for the Policy Claims Tracker demo. Run Register or Login first to store the JWT in the collection variable `token`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "55042d30-6eb3-4e90-8249-d6b6a7ca449d"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "policyId",
      "value": ""
    },
    {
      "key": "claimId",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      }
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('register success or existing user', function () {",
                  "  pm.expect([201, 409]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body.token) pm.collectionVariables.set('token', body.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Demo User\",\n  \"email\": \"postman.demo@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"adjuster\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login success', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "if (body.token) pm.collectionVariables.set('token', body.token);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@test.com\",\n  \"password\": \"test1234\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Current User",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Get Dashboard",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/dashboard",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "dashboard"
              ]
            }
          }
        },
        {
          "name": "Get Summary",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/summary",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "summary"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Policies",
      "item": [
        {
          "name": "List Policies",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/policies",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "policies"
              ]
            }
          }
        },
        {
          "name": "Create Policy",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('create policy success', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const body = pm.response.json();",
                  "if (body.policy && body.policy.id) pm.collectionVariables.set('policyId', body.policy.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"policyNumber\": \"POL-POSTMAN-1001\",\n  \"holderName\": \"Jordan Example\",\n  \"type\": \"auto\",\n  \"premium\": 425.5,\n  \"status\": \"active\",\n  \"effectiveDate\": \"2026-09-16\",\n  \"expirationDate\": \"2027-09-16\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/policies",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "policies"
              ]
            }
          }
        },
        {
          "name": "Get Policy By Id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/policies/{{policyId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "policies",
                "{{policyId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Claims",
      "item": [
        {
          "name": "List Claims",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/claims",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "claims"
              ]
            }
          }
        },
        {
          "name": "Create Claim",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('create claim success', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const body = pm.response.json();",
                  "if (body.claim && body.claim.id) pm.collectionVariables.set('claimId', body.claim.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"claimNumber\": \"CLM-POSTMAN-2001\",\n  \"policy\": \"{{policyId}}\",\n  \"incidentDate\": \"2026-09-15\",\n  \"amount\": 1200,\n  \"description\": \"Rear bumper damage from a parking lot collision\",\n  \"status\": \"submitted\",\n  \"assignedTo\": \"adjuster-01\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/claims",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "claims"
              ]
            }
          }
        },
        {
          "name": "Get Claim By Id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/claims/{{claimId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "claims",
                "{{claimId}}"
              ]
            }
          }
        },
        {
          "name": "Add Claim Note",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Followed up with the policy holder and requested supporting photos.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/claims/{{claimId}}/notes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "claims",
                "{{claimId}}",
                "notes"
              ]
            }
          }
        }
      ]
    }
  ]
}
